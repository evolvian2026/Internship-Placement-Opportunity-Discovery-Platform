# Copy to .env before running `docker compose up`.
# Generate the secrets with: openssl rand -hex 48

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=opportunities

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

API_PORT=4000
WEB_PORT=3000

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3000

# mock  = generate realistic sample opportunities, no external calls
# live  = run the source connectors an administrator has enabled
DATA_SOURCE=mock
INGESTION_ENABLED=true

# Leave blank to log emails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Opportunity Discovery <no-reply@example.com>

# Optional. Without it the assistant uses its deterministic planner, which
# still answers every supported question from the opportunity database.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5
