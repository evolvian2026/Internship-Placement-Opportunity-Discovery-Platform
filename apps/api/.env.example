# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opportunities?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opportunities_test?schema=public

# Connection pool. Prisma's default is (cores * 2 + 1) — around nine on a small
# container, which is fewer connections than one search can use at once, so
# concurrent traffic times out waiting for the pool. Size it against what the
# database will accept: connection_limit in DATABASE_URL overrides these.
DATABASE_CONNECTION_LIMIT=25
DATABASE_POOL_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Redis / queues. Leave REDIS_URL empty to run the in-process scheduler
# instead of BullMQ (useful for local development without Redis).
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
QUEUE_ENABLED=true

# ---------------------------------------------------------------------------
# Auth. Generate with: openssl rand -hex 48
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Ingestion.  DATA_SOURCE=mock generates realistic sample opportunities so the
# whole UI and analytics stack can be developed without external sources.
# DATA_SOURCE=live enables the real connectors that are marked enabled.
# ---------------------------------------------------------------------------
DATA_SOURCE=mock
INGESTION_ENABLED=true
INGESTION_USER_AGENT=OpportunityDiscoveryBot/1.0 (+https://example.com/bot)
INGESTION_DEFAULT_RATE_LIMIT=30
INGESTION_RESPECT_ROBOTS=true

# ---------------------------------------------------------------------------
# Object storage for resumes.  Defaults to the local filesystem in dev.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Email (nodemailer).  Without SMTP_HOST, emails are logged instead of sent.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Opportunity Discovery <no-reply@example.com>"

# ---------------------------------------------------------------------------
# AI career assistant.  The assistant is grounded in the opportunity database.
# Without an API key it falls back to the deterministic retrieval planner,
# which still answers every supported question using real database rows.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5
ASSISTANT_ENABLED=true

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Must exceed the idle timeout of whatever proxies to this service, or the
# proxy reuses a socket the server is closing and reports a 502 the
# application never saw. headersTimeout is derived from this.
KEEP_ALIVE_TIMEOUT_MS=65000
REQUEST_TIMEOUT_MS=120000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
MAX_RESUME_SIZE_MB=5
